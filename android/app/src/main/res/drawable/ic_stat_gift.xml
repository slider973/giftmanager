<?xml version="1.0" encoding="utf-8"?>
<!--
    Icône de la barre d'état des notifications (#76) : silhouette de cadeau pleine, blanc opaque sur fond transparent
    (Android n'en garde que le canal alpha et la teinte lui-même). Règles Android : 24 × 24 dp, zone utile 20 × 20 dp,
    aucun dégradé ni détail fin. Le ruban est un vide de 2 dp qui traverse nœud, couvercle et boîte ; le couvercle est
    détaché de la boîte par 1 dp : la forme reste lisible à 24 dp, en barre d'état comme dans le volet.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Nœud : deux boucles pleines, séparées par le ruban. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11,7.5C10.4,5 8.7,2.6 6.7,2.6C5.4,2.6 4.6,3.6 4.9,4.8C5.3,6.5 7.6,7.5 11,7.5Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13,7.5C13.6,5 15.3,2.6 17.3,2.6C18.6,2.6 19.4,3.6 19.1,4.8C18.7,6.5 16.4,7.5 13,7.5Z" />
    <!-- Couvercle. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,8.5H11V12H4A1,1 0,0 1,3 11V9.5A1,1 0,0 1,4 8.5Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13,8.5H20A1,1 0,0 1,21 9.5V11A1,1 0,0 1,20 12H13Z" />
    <!-- Boîte. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.5,13H11V21H5.5A1,1 0,0 1,4.5 20Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13,13H19.5V20A1,1 0,0 1,18.5 21H13Z" />
</vector>
