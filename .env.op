# Références 1Password (coffre "giftmanager") — aucune valeur en clair ici.
# Usage : op run --env-file=.env.op -- <commande>
#   ex. : op run --env-file=.env.op -- supabase link --project-ref "$SUPABASE_PROJECT_REF"

# Supabase (prod)
SUPABASE_PROJECT_REF=op://giftmanager/supabase/project_ref
SUPABASE_URL=op://giftmanager/supabase/url
SUPABASE_PUBLISHABLE_KEY=op://giftmanager/supabase/publishable_key
SUPABASE_SECRET_KEY=op://giftmanager/supabase/secret_key
SUPABASE_ACCESS_TOKEN=op://giftmanager/supabase/access_token
SUPABASE_DB_PASSWORD=op://giftmanager/supabase-db/password

# Apple
APPLE_TEAM_ID=op://giftmanager/apple-developer/team_id
APP_BUNDLE_ID=op://giftmanager/apple-developer/bundle_id
ASC_KEY_ID=op://giftmanager/app-store-connect/key_id
ASC_ISSUER_ID=op://giftmanager/app-store-connect/issuer_id
ASC_PRIVATE_KEY=op://giftmanager/app-store-connect/private_key

# Apple (connexion web Android, #83) : lus par `supabase config push` (auth.external.apple)
# client_id = « Services ID,bundle iOS » (Supabase envoie le premier à Apple pour le flux web) ; secret = JWT généré depuis la clé .p8 (6 mois max)
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=op://giftmanager/apple-signin-web/client_id
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=op://giftmanager/apple-signin-web/client_secret

# Google (connexion Android) : lus par `supabase config push` (auth.external.google)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=op://giftmanager/google-oauth/web_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=op://giftmanager/google-oauth/web_client_secret

# GitHub
PROJECT_TOKEN=op://giftmanager/github/project_token
